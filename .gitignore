# Binários compilados pelo GCC não têm extensão, então a estratégia aqui é
# ignorar tudo por padrão e reinscrever apenas o que é fonte ou configuração.
# IMPORTANTE: `!*/` é obrigatório — sem ele o diretório inteiro fica excluído
# e o Git não consegue reinscrever arquivos dentro dele.
*
!*/

# Fontes e configurações que fazem parte do repositório
!*.c
!*.h
!*.md
!*.sh
!Makefile
!.gitignore
!.vscode/*

# Artefatos de compilação com extensão (o GCC também aceita esses nomes)
*.exe
*.o
*.obj
*.out
*.a
*.so
*.gch
a.out

# Arquivos temporários de editor
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db

# Saída dos exercícios de struct/arquivos
*.bin
